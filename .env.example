# Anthropic API key used by ai.js (agent.js and server.js)
ANTHROPIC_API_KEY=

# Facebook Page access token, used to send replies via the Send API
PAGE_ACCESS_TOKEN=

# Any string you choose — must match the value entered in the Facebook App's
# webhook configuration for GET /webhook verification
VERIFY_TOKEN=

# Port the webhook server listens on (optional, defaults to 3000)
PORT=3000
